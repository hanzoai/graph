  "reference_baselines": [
    {
      "system": "Hanzo GraphPlanner (this PR)",
      "license": "Apache-2.0",
      "deployment_model": "Single-process embedded Go library (zero cluster)",
      "storage_layout": "Per-tenant bidirectional compact CSR (uint32 targets, uint16 types) + flat float32 vectors + BM25 postings",
      "measurement_status": "Measured (Local)",
      "bytes_per_edge_summary": "28.0 B/edge (CSR fwd+rev exact); 52.5 B/node intern+offsets",
      "query_latency_summary": "p50=0.0494 ms, p95=0.2565 ms (in-process)",
      "tradeoff_note": "Zero network RPC or cluster ops; cost-based planner dynamically bypasses graph on simple facts and pivots off hubs."
    },
    {
      "system": "Apache AGE (PostgreSQL graph extension)",
      "license": "Apache-2.0",
      "deployment_model": "PostgreSQL server + SQL/Cypher extension",
      "storage_layout": "PostgreSQL heap tuples (~24B tuple header + agtype JSONB properties) + B-tree indexes per label",
      "measurement_status": "Published Reference Architecture (not locally bench-executed)",
      "bytes_per_edge_summary": "~120–250 B/edge (heap tuple header + agtype + B-tree index overhead per PostgreSQL storage docs)",
      "query_latency_summary": "~1–15 ms typical single-hop SQL/Cypher round-trip (process/socket + planner + buffer pool)",
      "tradeoff_note": "Strong relational ACID integration, but high per-edge tuple/index overhead and SQL join overhead on multi-hop traversal."
    },
    {
      "system": "NebulaGraph",
      "license": "Apache-2.0",
      "deployment_model": "Distributed multi-process cluster (metad + graphd + storaged over Raft/RocksDB)",
      "storage_layout": "Partitioned RocksDB SSTables keyed by (partID, vertexID, edgeType, rank, dstID)",
      "measurement_status": "Published Reference Architecture (not locally bench-executed)",
      "bytes_per_edge_summary": "~64–140 B/edge on disk/memtable (RocksDB key+value+bloom/block index across Raft replicas)",
      "query_latency_summary": "~2–25 ms typical network RPC + distributed fan-out across storaged shards",
      "tradeoff_note": "Built for multi-billion-edge scale-out; unjustified operational/RPC overhead for single-process or \u003c10M-edge workloads."
    },
    {
      "system": "Cognee",
      "license": "Apache-2.0",
      "deployment_model": "Python ETL + external graph store (Neo4j/Kuzu/NetworkX) + external vector DB",
      "storage_layout": "Dual external stores (graph DB + vector DB) synchronized via LLM extraction pipelines",
      "measurement_status": "Published Reference Architecture (not locally bench-executed)",
      "bytes_per_edge_summary": "~150–400+ B/edge across dual Python object/external graph + vector payloads",
      "query_latency_summary": "~10–250+ ms typical Python orchestration + remote DB/embedding round-trips",
      "tradeoff_note": "Convenient LLM memory pipeline, but lacks embedded CSR locality, pre-traversal ACL isolation, and a cost-based physical planner."
    }
  ],
  "disclosures": [
    "Real engineering code-graph workload is parsed directly from canonical hanzoai/graph Go source files using go/parser + go/ast.",
    "STaRK semi-structured multi-hop, GraphRAG-Bench simple factual negative regime, hub explosion, tight latency budget, and ACL probes use deterministic seeded corpora; external STaRK/GraphRAG-Bench JSON bundles are supported at runtime via --external-dataset.",
    "Dense vectors use deterministic zero-dependency 128-dim signed FNV-1a unigram+bigram+char-4gram L2-normalized feature hashing (no external GPU or remote LLM API required).",
    "All 6 evaluated planner policies share the exact same canonical store, TopK budget, grounded extractive answer synthesizer, and judge.",
    "Apache AGE, NebulaGraph, and Cognee entries are explicitly labeled as published reference architecture baselines (not locally bench-executed) so external numbers are never conflated with local wall-clock measurements.",
    "Token cost formula: $3.00 / 1M retrieved input tokens; Cost/1M useful tokens = $3.00 * (total_retrieved_tokens / useful_gold_tokens)."
  ]
